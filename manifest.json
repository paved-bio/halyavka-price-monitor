{
  "manifest_version": 3,
  "name": "Price Monitor",
  "version": "1.8.18",
  "description": "Трекер цен Ozon/WB/Steam/Avito/Tutu + earn-сценарии. Telegram-уведомления.",
  "permissions": ["storage", "alarms", "tabs", "idle", "scripting", "notifications", "nativeMessaging"],
  "host_permissions": [
    "http://127.0.0.1:8760/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://halyavka.online/*",
    "https://*.ozon.ru/*",
    "https://ozon.ru/*",
    "https://*.wildberries.ru/*",
    "https://wildberries.ru/*",
    "https://*.steampowered.com/*",
    "https://steampowered.com/*",
    "https://*.avito.ru/*",
    "https://avito.ru/*",
    "https://*.tutu.ru/*",
    "https://tutu.ru/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*.twitch.tv/*",
    "https://twitch.tv/*",
    "http://127.0.0.1:8766/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://halyavka.online/earn/*", "http://127.0.0.1/*/earn/*", "http://localhost/*/earn/*"],
      "js": ["earn_bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.ozon.ru/product/*",
        "https://ozon.ru/product/*",
        "https://*.wildberries.ru/catalog/*/detail.aspx*",
        "https://wildberries.ru/catalog/*/detail.aspx*"
      ],
      "js": ["utils_price.js", "comparison_widget.js"],
      "css": ["comparison_widget.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Price Monitor — трекер цен"
  },
  "web_accessible_resources": [
    {
      "resources": ["transparency.html", "worker_info.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
